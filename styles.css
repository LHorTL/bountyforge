:root {
  /* Minimal-White Anti-AI-Slop Design Tokens */
  --bg-canvas: #ffffff;
  --surface-subtle: #f7f8fa;
  --tag-bg: #f3f4f6;
  --ink: #18181b;
  --ink-secondary: #52525b;
  --ink-muted: #8b8d94;

  /* 1px Hairline Dividers */
  --line: #e6e8ec;
  --line-soft: #f0f1f4;

  /* Semantic Status Tokens (Shallow Fog + 1px Border + High-Contrast Ink) */
  --ok-ink: #047857;
  --ok-bg: #ecfdf5;
  --ok-border: #a7f3d0;
  --err-ink: #b91c1c;
  --err-bg: #fef2f2;
  --err-border: #fecaca;
  --warn-ink: #92400e;
  --warn-bg: #fffbeb;
  --warn-border: #fde68a;

  /* Single Domain Accent — Crisp Gno Indigo */
  --accent: #4338ca;
  --accent-deep: #3730a3;
  --accent-soft: #eef2ff;
  --accent-border: #c7d2fe;

  --radius: 6px;
  --radius-sm: 4px;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --sans: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  padding: 0;
  min-height: 100vh;
  background: var(--bg-canvas);
  color: var(--ink);
  font-family: var(--sans);
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

a {
  color: var(--accent-deep);
  text-decoration: none;
}

a:hover {
  text-decoration: underline;
}

.mono {
  font-family: var(--mono);
  font-variant-numeric: tabular-nums;
}

.text-accent {
  color: var(--accent-deep);
  font-weight: 600;
}

.text-ok {
  color: var(--ok-ink);
  font-weight: 600;
}

.app-shell {
  max-width: 1240px;
  margin: 0 auto;
  padding: 20px 24px 56px;
  background: var(--bg-canvas);
}

/* Identity Header (Left 4px x 26px Accent Bar + Compact Controls, 1px Bottom Hairline) */
.topbar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 4px 0 18px;
  border-bottom: 1px solid var(--line);
  margin-bottom: 18px;
  background: var(--bg-canvas);
}

.brand {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  flex: 1 1 320px;
  min-width: 0;
  max-width: 100%;
}

.brand-accent-bar {
  width: 4px;
  height: 26px;
  border-radius: 2px;
  background: var(--accent);
  margin-top: 3px;
  flex-shrink: 0;
}

.brand-title {
  margin: 0;
  font-size: 24px;
  font-weight: 800;
  letter-spacing: -0.015em;
  line-height: 1.2;
  color: var(--ink);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 9px;
}

.brand-sub {
  margin: 3px 0 0;
  font-size: 13px;
  color: var(--ink-secondary);
}

.badge-tag {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  background: var(--accent-soft);
  color: var(--accent-deep);
  border: 1px solid var(--accent-border);
}

.snapshot-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  background: var(--warn-bg);
  color: var(--warn-ink);
  border: 1px solid var(--warn-border);
  white-space: nowrap;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  flex: 0 1 auto;
  max-width: 100%;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 5px 10px;
  border-radius: var(--radius-sm);
  font-size: 12px;
  font-family: var(--mono);
  font-variant-numeric: tabular-nums;
  color: var(--ink-secondary);
  background: var(--surface-subtle);
  border: 1px solid var(--line);
  max-width: 100%;
}

.status-pill .dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--ink-muted);
  flex-shrink: 0;
}

.status-pill.status-live .dot {
  background: var(--ok-ink);
}

.status-pill.status-inert {
  background: var(--warn-bg);
  border-color: var(--warn-border);
  color: var(--warn-ink);
}

.status-pill.status-inert .dot {
  background: var(--warn-ink);
}

.status-pill.status-offline {
  background: var(--warn-bg);
  border-color: var(--warn-border);
  color: var(--warn-ink);
}

.status-pill.status-offline .dot {
  background: var(--warn-ink);
}

/* Status Banner */
.banner {
  margin-bottom: 18px;
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--warn-border);
  border-left: 3px solid var(--warn-ink);
  background: var(--warn-bg);
  color: var(--warn-ink);
  font-size: 12.5px;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.banner-main {
  display: inline-flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.banner span:last-child {
  overflow-wrap: anywhere;
  color: var(--ink-secondary);
  font-size: 11.5px;
}

.banner.banner-live {
  border-color: var(--ok-border);
  border-left-color: var(--ok-ink);
  background: var(--ok-bg);
  color: var(--ok-ink);
}

/* Unified Hairline KPI Strip */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  background: var(--line);
  gap: 1px;
  margin-bottom: 20px;
}

.kpi-card {
  background: var(--bg-canvas);
  padding: 13px 16px;
  min-width: 0;
}

.kpi-label {
  font-size: 11px;
  font-weight: 600;
  color: var(--ink-muted);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.kpi-value {
  font-size: 20px;
  font-weight: 700;
  font-family: var(--mono);
  font-variant-numeric: tabular-nums;
  color: var(--ink);
  margin: 4px 0 2px;
  line-height: 1.25;
}

.kpi-meta {
  font-size: 12px;
  color: var(--ink-secondary);
  font-variant-numeric: tabular-nums;
}

.accent-cyan,
.accent-gold {
  color: var(--accent-deep);
}

.accent-green {
  color: var(--ok-ink);
}

/* Minimal Underline Tabs + Primary CTA */
.nav-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 20px;
  border-bottom: 1px solid var(--line);
}

.tabs {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}

.tab {
  background: transparent;
  color: var(--ink-secondary);
  border: none;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  padding: 10px 14px;
  font-family: var(--sans);
  font-size: 13.5px;
  font-weight: 600;
  cursor: pointer;
  transition: color 0.12s ease, border-color 0.12s ease;
}

.tab:hover {
  color: var(--ink);
}

.tab.active {
  color: var(--accent-deep);
  border-bottom-color: var(--accent);
}

.nav-cta {
  padding-bottom: 8px;
}

.tab-panel {
  display: none;
}

.tab-panel.active {
  display: block;
}

/* Flat Crisp Buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 7px 13px;
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  transition: background-color 0.12s ease, border-color 0.12s ease;
  font-family: var(--sans);
  background: var(--bg-canvas);
  color: var(--ink);
}

.btn:hover {
  background: var(--surface-subtle);
  border-color: #cbd5e1;
  text-decoration: none;
}

.btn-primary,
.btn-gold {
  background: var(--accent);
  border-color: var(--accent);
  color: #ffffff;
}

.btn-primary:hover,
.btn-gold:hover {
  background: var(--accent-deep);
  border-color: var(--accent-deep);
}

.btn-ghost {
  background: var(--bg-canvas);
  color: var(--ink);
  border-color: var(--line);
}

.btn-ghost:hover {
  background: var(--surface-subtle);
  border-color: #cbd5e1;
}

.btn-danger {
  background: var(--err-bg);
  color: var(--err-ink);
  border-color: var(--err-border);
}

.btn-danger:hover {
  background: #fee2e2;
  border-color: #f5b5b5;
}

.btn-sm {
  padding: 5px 10px;
  font-size: 12px;
}

.btn-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

/* Filter Bar */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 16px;
}

.filter-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.pill {
  background: var(--surface-subtle);
  color: var(--ink-secondary);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 5px 11px;
  font-family: var(--sans);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.12s ease, color 0.12s ease, border-color 0.12s ease;
}

.pill:hover {
  color: var(--ink);
  border-color: #cbd5e1;
}

.pill.active {
  background: var(--accent-soft);
  color: var(--accent-deep);
  border-color: var(--accent-border);
}

.search-input {
  background: var(--bg-canvas);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 7px 11px;
  width: 280px;
  max-width: 100%;
  font-family: var(--sans);
  font-size: 13px;
  outline: none;
}

.search-input:focus {
  border-color: var(--accent);
}

/* Bounty Board Grid */
.bounty-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
  gap: 14px;
}

.bounty-card {
  background: var(--bg-canvas);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 9px;
  cursor: pointer;
  min-width: 0;
  max-width: 100%;
  transition: border-color 0.12s ease, background-color 0.12s ease;
}

.bounty-card:hover {
  border-color: var(--accent-border);
  background: var(--surface-subtle);
}

.bounty-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.bounty-id {
  font-family: var(--mono);
  font-variant-numeric: tabular-nums;
  font-size: 11.5px;
  font-weight: 600;
  color: var(--ink-muted);
}

.bounty-reward {
  font-family: var(--mono);
  font-variant-numeric: tabular-nums;
  font-size: 18px;
  font-weight: 700;
  color: var(--ink);
}

.bounty-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--ink);
  margin: 0;
  line-height: 1.35;
}

.bounty-summary {
  font-size: 13px;
  color: var(--ink-secondary);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.bounty-meta {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  font-size: 12px;
  color: var(--ink-secondary);
  font-family: var(--mono);
  font-variant-numeric: tabular-nums;
  margin-top: auto;
  padding-top: 10px;
  border-top: 1px solid var(--line-soft);
}

/* Status Badges */
.status-badge {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  text-transform: uppercase;
  white-space: nowrap;
}

.status-OPEN {
  background: var(--ok-bg);
  color: var(--ok-ink);
  border-color: var(--ok-border);
}

.status-PAID {
  background: var(--accent-soft);
  color: var(--accent-deep);
  border-color: var(--accent-border);
}

.status-DISPUTED {
  background: var(--warn-bg);
  color: var(--warn-ink);
  border-color: var(--warn-border);
}

.status-CANCELLED {
  background: var(--tag-bg);
  color: var(--ink-secondary);
  border-color: var(--line);
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.tag {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: var(--radius-sm);
  background: var(--tag-bg);
  color: var(--ink-secondary);
  border: 1px solid var(--line);
  white-space: nowrap;
}

/* Flat Sections / Panels (Zero Nested Dark Boxes) */
.panel-card {
  background: var(--bg-canvas);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 18px 20px;
  min-width: 0;
  max-width: 100%;
}

.panel-card h2 {
  margin: 0 0 6px;
  font-size: 16px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.01em;
}

.panel-card h3 {
  margin: 16px 0 8px;
  font-size: 13.5px;
  font-weight: 700;
  color: var(--ink);
}

.muted {
  color: var(--ink-secondary);
  font-size: 13px;
  margin: 0 0 14px;
}

.muted code,
.feature-list code,
.panel-card h3 code {
  font-family: var(--mono);
  font-size: 11.5px;
  background: var(--tag-bg);
  border: 1px solid var(--line);
  border-radius: 3px;
  padding: 0 4px;
  color: var(--ink);
}

.panel-header {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14px;
  margin-bottom: 16px;
}

.panel-header > div:first-child {
  flex: 1 1 280px;
  min-width: 0;
}

/* Split Studio */
.split-controls-top {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 10px;
  max-width: 100%;
}

.inline-field {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 11.5px;
  font-weight: 600;
  color: var(--ink-secondary);
}

.inline-field input {
  background: var(--bg-canvas);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 6px 9px;
  width: 132px;
  max-width: 100%;
  font-family: var(--mono);
  font-variant-numeric: tabular-nums;
  font-size: 13px;
  outline: none;
}

.inline-field input:focus {
  border-color: var(--accent);
}

.split-bar-visual {
  height: 14px;
  border-radius: var(--radius-sm);
  overflow: hidden;
  display: flex;
  background: var(--line-soft);
  margin-bottom: 14px;
  border: 1px solid var(--line);
}

.split-segment {
  height: 100%;
  transition: width 0.15s ease;
  border-right: 1px solid var(--bg-canvas);
}

.split-segment:last-child {
  border-right: none;
}

.split-rows {
  display: flex;
  flex-direction: column;
  border-top: 1px solid var(--line);
  margin-bottom: 14px;
}

.split-row {
  display: grid;
  grid-template-columns: 74px minmax(130px, 1fr) minmax(140px, 2fr) 86px 140px 32px;
  align-items: center;
  gap: 10px;
  padding: 10px 4px;
  border-bottom: 1px solid var(--line-soft);
  background: var(--bg-canvas);
}

.split-row > * {
  min-width: 0;
}

.split-row input[type="range"] {
  width: 100%;
  accent-color: var(--accent);
}

.split-row input[type="number"],
.split-row input[type="text"] {
  background: var(--bg-canvas);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 6px 8px;
  font-family: var(--mono);
  font-variant-numeric: tabular-nums;
  font-size: 12px;
  width: 100%;
  outline: none;
}

.split-row input[type="number"]:focus,
.split-row input[type="text"]:focus {
  border-color: var(--accent);
}

.split-payout-col {
  font-family: var(--mono);
  font-variant-numeric: tabular-nums;
  font-size: 12.5px;
  font-weight: 600;
  text-align: right;
  color: var(--ink);
}

.split-payout-col .muted {
  font-size: 11.5px;
  font-weight: 400;
  margin: 0;
}

.split-footer {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-top: 12px;
  margin-bottom: 14px;
}

.split-summary {
  display: flex;
  gap: 18px;
  font-family: var(--mono);
  font-variant-numeric: tabular-nums;
  font-size: 12.5px;
  color: var(--ink-secondary);
  flex-wrap: wrap;
}

.split-summary strong {
  color: var(--ink);
}

/* Light Hairline Code Boxes */
.code-box {
  background: var(--surface-subtle);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 12px 14px;
  font-family: var(--mono);
  font-variant-numeric: tabular-nums;
  font-size: 12px;
  color: var(--ink);
  overflow-x: auto;
  white-space: pre-wrap;
  word-break: break-all;
  margin: 0;
}

.code-box.small {
  font-size: 11.5px;
  max-height: 110px;
}

.code-box.code-tall {
  max-height: 360px;
  overflow-y: auto;
}

/* Split & Two-Col Layouts */
.split-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
  gap: 18px;
  align-items: start;
}

.two-col {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  align-items: start;
}

/* Full-Bleed Crisp Tables */
.table-wrap {
  width: 100%;
  max-width: 100%;
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12.5px;
  background: var(--bg-canvas);
}

.data-table th,
.data-table td {
  padding: 9px 10px;
  border-bottom: 1px solid var(--line-soft);
  text-align: left;
  color: var(--ink);
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.data-table thead th {
  background: var(--surface-subtle);
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--ink-muted);
  border-bottom: 1px solid var(--line);
}

.data-table tbody tr:last-child td {
  border-bottom: none;
}

.data-table tbody tr {
  cursor: pointer;
  transition: background-color 0.12s ease;
}

.data-table tbody tr:hover td {
  background: var(--surface-subtle);
}

/* SVG Credential Preview */
.svg-preview {
  width: 100%;
  margin: 10px 0 14px;
}

.svg-preview svg {
  width: 100%;
  height: auto;
  display: block;
}

.meta-kv {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 12.5px;
}

.meta-kv-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 12px;
  padding-bottom: 7px;
  border-bottom: 1px solid var(--line-soft);
}

.meta-kv-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.meta-kv-row span:first-child {
  color: var(--ink-secondary);
  flex-shrink: 0;
}

.meta-kv-row span:last-child {
  color: var(--ink);
  text-align: right;
  overflow-wrap: anywhere;
}

.feature-list {
  padding-left: 18px;
  margin: 0 0 14px;
  font-size: 13px;
  color: var(--ink-secondary);
}

.feature-list li {
  margin-bottom: 6px;
}

/* Semantic Alerts */
.alert {
  padding: 9px 12px;
  border-radius: var(--radius-sm);
  font-size: 12.5px;
  margin-bottom: 12px;
}

.alert-danger {
  background: var(--err-bg);
  border: 1px solid var(--err-border);
  color: var(--err-ink);
}

/* Crisp Modals (Zero Blur, Zero Heavy Shadow) */
.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: rgba(24, 24, 27, 0.42);
  display: grid;
  place-items: center;
  padding: 16px;
}

.modal {
  width: 100%;
  max-width: 560px;
  max-height: 90vh;
  overflow-y: auto;
  background: var(--bg-canvas);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 20px 22px;
}

.modal-lg {
  max-width: 780px;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  padding-bottom: 12px;
  margin-bottom: 14px;
  border-bottom: 1px solid var(--line);
}

.modal-header h2 {
  margin: 4px 0 0;
  font-size: 17px;
  font-weight: 700;
  color: var(--ink);
}

.icon-btn {
  background: transparent;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  color: var(--ink-secondary);
  font-size: 20px;
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  cursor: pointer;
  line-height: 1;
}

.icon-btn:hover {
  color: var(--ink);
  background: var(--surface-subtle);
  border-color: var(--line);
}

.modal-footer {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin-top: 14px;
  padding-top: 12px;
  border-top: 1px solid var(--line-soft);
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.form-stack label {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 12px;
  font-weight: 600;
  color: var(--ink-secondary);
}

.form-stack input,
.form-stack textarea {
  background: var(--bg-canvas);
  color: var(--ink);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  padding: 8px 10px;
  font-size: 13px;
  font-family: var(--sans);
  outline: none;
}

.form-stack input:focus,
.form-stack textarea:focus {
  border-color: var(--accent);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
}

.detail-section {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}

.detail-section h3 {
  margin: 0 0 8px;
  font-size: 13.5px;
  font-weight: 700;
  color: var(--ink);
}

.badge-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
}

.toast-root {
  position: fixed;
  right: 20px;
  bottom: 20px;
  z-index: 60;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.toast {
  background: var(--bg-canvas);
  border: 1px solid var(--line);
  border-left: 3px solid var(--accent);
  color: var(--ink);
  padding: 9px 14px;
  border-radius: var(--radius-sm);
  font-size: 12.5px;
}

.hidden {
  display: none !important;
}

@media (max-width: 900px) {
  .kpi-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .split-layout,
  .two-col {
    grid-template-columns: 1fr;
  }
  .split-row {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .split-payout-col {
    text-align: left;
  }
  .form-row {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .app-shell {
    padding: 14px 14px 40px;
  }
  .brand-title {
    font-size: 21px;
  }
  .kpi-grid {
    grid-template-columns: 1fr;
  }
  .search-input {
    width: 100%;
  }
  .inline-field input {
    width: 112px;
  }
  .panel-card {
    padding: 14px 14px;
  }
}
